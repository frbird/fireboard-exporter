{
  "annotations": { "list": [] },
  "description": "Probe temperatures are only exported while a FireBoard cook session is open. With no active session, temperature panels stay empty (exporter health/API still shown).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "One series per probe during an active cook session. No open session → exporter does not write temps, so this panel is empty.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": false },
          "unit": "fahrenheit"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 18, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "lastNotNull", "min", "max"] } },
      "targets": [
        {
          "expr": "last_over_time(fireboard_channel_temperature_celsius[2m]) * 9/5 + 32",
          "legendFormat": "{{channel_label}}",
          "refId": "A"
        }
      ],
      "title": "Channel temperatures (°F) — active session probes",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Average chamber/pit temperature over the dashboard time range (only samples written during open sessions). Matches channel_label against $chamber_regex.",
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "avg_over_time((fireboard_channel_temperature_celsius{channel_label=~\"$chamber_regex\"} * 9/5 + 32)[$__range:])",
          "legendFormat": "avg chamber",
          "refId": "A"
        }
      ],
      "title": "Avg chamber (°F) — selected range",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Chamber/pit probe during an active session ($chamber_regex).",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "spanNulls": false },
          "unit": "fahrenheit"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 5 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "lastNotNull"] } },
      "targets": [
        {
          "expr": "last_over_time(fireboard_channel_temperature_celsius{channel_label=~\"$chamber_regex\"}[2m]) * 9/5 + 32",
          "legendFormat": "{{channel_label}}",
          "refId": "A"
        }
      ],
      "title": "Chamber / pit (°F)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "How long meat probes spent in each temperature band over the selected range (session-only samples). Stall ≈ 150–170°F.",
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "custom": {
            "gradientMode": "scheme"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 10 },
      "id": 6,
      "options": {
        "bucketCount": 40,
        "bucketOffset": 0,
        "bucketSize": 0
      },
      "targets": [
        {
          "expr": "fireboard_channel_temperature_celsius{channel_label!~\"$chamber_regex\"} * 9/5 + 32",
          "legendFormat": "{{channel_label}}",
          "refId": "A"
        }
      ],
      "title": "Meat time-at-temp histogram (°F)",
      "type": "histogram"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Meat probe heatmap over time (session-only samples). A flat band at 150–170°F is the stall.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "scaleDistribution": { "type": "linear" }
          },
          "unit": "fahrenheit"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 10 },
      "id": 7,
      "options": {
        "calculate": true,
        "calculation": { "xBuckets": { "mode": "count", "value": "60" }, "yBuckets": { "mode": "count", "value": "40" } },
        "cellGap": 1,
        "color": { "scheme": "Spectral", "steps": 64, "mode": "scheme", "fill": "dark-orange" },
        "legend": { "show": true },
        "tooltip": { "mode": "single", "yHistogram": true },
        "yAxis": { "unit": "fahrenheit", "decimals": 0 }
      },
      "targets": [
        {
          "expr": "fireboard_channel_temperature_celsius{channel_label!~\"$chamber_regex\"} * 9/5 + 32",
          "legendFormat": "{{channel_label}}",
          "refId": "A"
        }
      ],
      "title": "Meat temp heatmap (stall view)",
      "type": "heatmap"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Open FireBoard cook sessions currently known to the exporter.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "none", "color": "text" }, "1": { "text": "active", "color": "green" } }, "type": "value" }
          ],
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 19 },
      "id": 8,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "max(fireboard_session_info) or vector(0)",
          "legendFormat": "session",
          "refId": "A"
        }
      ],
      "title": "Active cook session",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "down", "color": "red" }, "1": { "text": "up", "color": "green" } }, "type": "value" }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 19 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "fireboard_up",
          "refId": "A"
        }
      ],
      "title": "Exporter poll status",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 19 },
      "id": 3,
      "targets": [
        {
          "expr": "rate(fireboard_api_requests_total[15m])",
          "legendFormat": "{{endpoint}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "API request rate",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["fireboard", "bbq", "stall"],
  "templating": {
    "list": [
      {
        "current": {},
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "current": {
          "selected": true,
          "text": "(?i)pit|chamber|grill|air|cooker|ambient",
          "value": "(?i)pit|chamber|grill|air|cooker|ambient"
        },
        "description": "Regex matched against channel_label for chamber/pit panels. Meat histogram/heatmap use the inverse.",
        "label": "Chamber label regex",
        "name": "chamber_regex",
        "query": "(?i)pit|chamber|grill|air|cooker|ambient",
        "skipUrlSync": false,
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Fireboard Overview",
  "uid": "fireboard-overview",
  "version": 4
}
