{
  "annotations": { "list": [] },
  "description": "TV-friendly FireBoard cook dashboard. Probe temps only while a session is open. Giant live numbers are sized for viewing across a room. Channel renames join via fireboard_channel_info so legends stay unique.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Current probe temps during an active session — large type for TV viewing.",
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 100 },
              { "color": "yellow", "value": 150 },
              { "color": "orange", "value": 170 },
              { "color": "red", "value": 200 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 },
      "id": 10,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name",
        "wideLayout": true,
        "text": { "titleSize": 36, "valueSize": 120 }
      },
      "targets": [
        {
          "expr": "(\n  max by (device_uuid, channel) (last_over_time(fireboard_channel_temperature_celsius[2m]))\n  * on (device_uuid, channel) group_left (channel_label)\n    max by (device_uuid, channel, channel_label) (fireboard_channel_info)\n) * 9/5 + 32",
          "legendFormat": "{{channel_label}}",
          "refId": "A"
        }
      ],
      "title": "Live probe temperatures (°F)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Average chamber temp over the dashboard time range.",
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "blue", "value": 0 },
              { "color": "green", "value": 200 },
              { "color": "orange", "value": 250 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 12 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value_and_name",
        "text": { "titleSize": 28, "valueSize": 96 }
      },
      "targets": [
        {
          "expr": "avg_over_time((\n  (\n    max by (device_uuid, channel) (fireboard_channel_temperature_celsius)\n    * on (device_uuid, channel) group_left (channel_label)\n      max by (device_uuid, channel, channel_label) (fireboard_channel_info)\n  ){channel_label=~\"$chamber_regex\"} * 9/5 + 32\n)[$__range:])",
          "legendFormat": "avg chamber",
          "refId": "A"
        }
      ],
      "title": "Avg chamber (°F)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Whether an open FireBoard cook session is detected.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "NO SESSION", "color": "text" }, "1": { "text": "COOKING", "color": "green" } }, "type": "value" }
          ],
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value",
        "text": { "valueSize": 64 }
      },
      "targets": [
        {
          "expr": "max(fireboard_session_info) or vector(0)",
          "legendFormat": "session",
          "refId": "A"
        }
      ],
      "title": "Session",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Probe trends for the selected range (session-only samples).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 3,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "fahrenheit"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 19 },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["lastNotNull", "mean", "min", "max"],
          "fontSize": "14"
        }
      },
      "targets": [
        {
          "expr": "(\n  max by (device_uuid, channel) (last_over_time(fireboard_channel_temperature_celsius[2m]))\n  * on (device_uuid, channel) group_left (channel_label)\n    max by (device_uuid, channel, channel_label) (fireboard_channel_info)\n) * 9/5 + 32",
          "legendFormat": "{{channel_label}}",
          "refId": "A"
        }
      ],
      "title": "Temperature trend (°F)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Time-at-temp for meat probes. Stall ≈ 150–170°F.",
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "custom": { "gradientMode": "scheme" }
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 29 },
      "id": 6,
      "options": {
        "bucketCount": 40,
        "bucketOffset": 0,
        "bucketSize": 0
      },
      "targets": [
        {
          "expr": "(\n  max by (device_uuid, channel) (fireboard_channel_temperature_celsius)\n  * on (device_uuid, channel) group_left (channel_label)\n    max by (device_uuid, channel, channel_label) (fireboard_channel_info)\n){channel_label!~\"$chamber_regex\"} * 9/5 + 32",
          "legendFormat": "{{channel_label}}",
          "refId": "A"
        }
      ],
      "title": "Meat time-at-temp (°F)",
      "type": "histogram"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Meat temp heatmap — flat band at 150–170°F is the stall.",
      "fieldConfig": {
        "defaults": {
          "custom": { "scaleDistribution": { "type": "linear" } },
          "unit": "fahrenheit"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 29 },
      "id": 7,
      "options": {
        "calculate": true,
        "calculation": {
          "xBuckets": { "mode": "count", "value": "60" },
          "yBuckets": { "mode": "count", "value": "40" }
        },
        "cellGap": 1,
        "color": { "scheme": "Spectral", "steps": 64, "mode": "scheme", "fill": "dark-orange" },
        "legend": { "show": true },
        "tooltip": { "mode": "single", "yHistogram": true },
        "yAxis": { "unit": "fahrenheit", "decimals": 0 }
      },
      "targets": [
        {
          "expr": "(\n  max by (device_uuid, channel) (fireboard_channel_temperature_celsius)\n  * on (device_uuid, channel) group_left (channel_label)\n    max by (device_uuid, channel, channel_label) (fireboard_channel_info)\n){channel_label!~\"$chamber_regex\"} * 9/5 + 32",
          "legendFormat": "{{channel_label}}",
          "refId": "A"
        }
      ],
      "title": "Meat temp heatmap (stall)",
      "type": "heatmap"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "down", "color": "red" }, "1": { "text": "up", "color": "green" } }, "type": "value" }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 38 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "text": { "valueSize": 32 }
      },
      "targets": [
        {
          "expr": "fireboard_up",
          "refId": "A"
        }
      ],
      "title": "Exporter",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 18, "x": 6, "y": 38 },
      "id": 3,
      "targets": [
        {
          "expr": "rate(fireboard_api_requests_total[15m])",
          "legendFormat": "{{endpoint}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "API request rate",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["fireboard", "bbq", "stall", "tv"],
  "templating": {
    "list": [
      {
        "current": {},
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "current": {
          "selected": true,
          "text": "(?i)pit|chamber|grill|air|cooker|ambient",
          "value": "(?i)pit|chamber|grill|air|cooker|ambient"
        },
        "description": "Regex for chamber/pit probe labels. Meat panels use the inverse.",
        "label": "Chamber label regex",
        "name": "chamber_regex",
        "query": "(?i)pit|chamber|grill|air|cooker|ambient",
        "skipUrlSync": false,
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Fireboard Overview",
  "uid": "fireboard-overview",
  "version": 7
}
