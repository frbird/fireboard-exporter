// Example Grafana Alloy scrape job for the Fireboard exporter.
// Merge into your existing Alloy config; keep your Grafana Cloud remote_write block.

prometheus.scrape "fireboard" {
  targets = [
    {"__address__" = "fireboard-exporter.fireboard.svc.cluster.local:8080"},
  ]
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
  metrics_path    = "/metrics"
  scrape_interval = "60s"
  scrape_timeout  = "10s"
  job_name        = "fireboard-exporter"
}

