# Required: at least one sink
# SINKS=grafana
# SINKS=influx
# SINKS=grafana,influx
SINKS=grafana

# FireBoard auth — token preferred; otherwise username + password
FIREBOARD_TOKEN=
# FIREBOARD_USERNAME=
# FIREBOARD_PASSWORD=
FIREBOARD_USER_AGENT=FireboardExporter/0.1.0
# FIREBOARD_BASE_URL=https://fireboard.io

# Polling (min 20s — FireBoard rate limit is 17 calls / 5 minutes)
POLL_INTERVAL_SECONDS=60
SESSION_POLL_INTERVAL_SECONDS=300
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080
APP_VERSION=0.1.0

# --- Grafana sink ---
# Scrape path: expose :8080/metrics to Grafana Alloy (see deploy/alloy/)
# Optional direct remote_write (no Alloy required):
# GRAFANA_REMOTE_WRITE_URL=https://prometheus-prod-XX-prod-us-central-0.grafana.net/api/prom/push
# GRAFANA_REMOTE_WRITE_USERNAME=your-instance-id
# GRAFANA_REMOTE_WRITE_TOKEN=glc_...

# --- Influx sink (required when SINKS includes influx) ---
# INFLUX_URL=http://influxdb:8086
# INFLUX_TOKEN=
# INFLUX_ORG=home
# INFLUX_BUCKET=fireboard
